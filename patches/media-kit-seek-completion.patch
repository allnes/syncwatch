+  /// Seeks and waits for a new decoded frame, including a queued seek.
+  /// Unlike the command reply, MPV_EVENT_PLAYBACK_RESTART follows decoding.
+  /// The shared command lock is released while the decoder is working.
+  Future<void> seekAndWaitForFrame(
+    Duration position, {
+    Duration timeout = const Duration(seconds: 30),
+  }) async {
+    final ready = Completer<void>();
+    // Disposal may fail this future while the command is still completing.
+    ready.future.ignore();
+    try {
+      await lock.synchronized(() async {
+        if (disposed) throw StateError('[Player] has been disposed');
+        await waitForPlayerInitialization;
+        await waitForVideoControllerInitializationIfAttached;
+        _frameSeekRequests[ready] = false;
+        await seek(position, synchronized: false);
+      });
+      await ready.future.timeout(timeout);
+    } finally {
+      _frameSeekRequests.remove(ready);
+    }
+  }
