+  /// Retrieves a string property through mpv's asynchronous reply queue.
+  /// Do not await this from a property observer: observers run in the same
+  /// event handler that must deliver the reply.
+  Future<String> getPropertyAsync(String property) async {
+    if (disposed) {
+      throw StateError('[Player] has been disposed');
+    }
+    await waitForPlayerInitialization;
+    await waitForVideoControllerInitializationIfAttached;
+    if (disposed) {
+      throw StateError('[Player] has been disposed');
+    }
+
+    final requestNumber = _asyncRequestNumber++;
+    final result = Completer<String>();
+    _getPropertyRequests[requestNumber] = result;
+    final name = property.toNativeUtf8();
+    try {
+      final immediate = mpv.mpv_get_property_async(
+        ctx,
+        requestNumber,
+        name.cast(),
+        generated.mpv_format.MPV_FORMAT_STRING,
+      );
+      if (immediate < 0) {
+        _getPropertyRequests.remove(requestNumber);
+        return '';
+      }
+    } catch (_) {
+      _getPropertyRequests.remove(requestNumber);
+      rethrow;
+    } finally {
+      calloc.free(name);
+    }
+    return result.future;
+  }
