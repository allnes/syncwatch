+// Keeps ownership in the test while following FlutterTexture's copy contract.
+@interface PoolTestExternalTexture : NSObject <FlutterTexture>
+@property(nonatomic, assign) CVPixelBufferRef pixelBuffer;
+@end
+@implementation PoolTestExternalTexture
+- (CVPixelBufferRef)copyPixelBuffer {
+  return _pixelBuffer ? CVPixelBufferRetain(_pixelBuffer) : nullptr;
+}
+@end
+
 namespace flutter::testing {

 // Test-specific name for AutoreleasePoolTest fixture.
 using FlutterEmbedderExternalTextureTest = AutoreleasePoolTest;

+TEST_F(FlutterEmbedderExternalTextureTest, TestRetiredTexturePoolsAreReleased) {
+  FlutterDarwinContextMetalSkia* metal =
+      [[FlutterDarwinContextMetalSkia alloc] initWithDefaultMTLDevice];
+  PoolTestExternalTexture* producer = [[PoolTestExternalTexture alloc] init];
+  FlutterExternalTexture* holder =
+      [[FlutterExternalTexture alloc] initWithFlutterTexture:producer darwinMetalContext:metal];
+  const NSUInteger start = metal.device.currentAllocatedSize;
+  id<MTLTexture> retained = nil;
+  for (int cycle = 0; cycle < 40; ++cycle) {
+    @autoreleasepool {
+      const size_t width = cycle % 2 ? 512 : 1024;
+      const size_t height = cycle % 2 ? 256 : 512;
+      for (int buffer = 0; buffer < 3; ++buffer) {
+        CVPixelBufferRef pixels = nullptr;
+        NSDictionary* options = @{(NSString*)kCVPixelBufferMetalCompatibilityKey : @YES};
+        ASSERT_EQ(CVPixelBufferCreate(kCFAllocatorDefault, width, height,
+                                     kCVPixelFormatType_32BGRA,
+                                     (__bridge CFDictionaryRef)options, &pixels), kCVReturnSuccess);
+        CVPixelBufferLockBaseAddress(pixels, 0);
+        memset(CVPixelBufferGetBaseAddress(pixels), 41 + cycle,
+               CVPixelBufferGetBytesPerRow(pixels) * height);
+        CVPixelBufferUnlockBaseAddress(pixels, 0);
+        producer.pixelBuffer = pixels;
+        FlutterMetalExternalTexture mapped = {};
+        ASSERT_TRUE([holder populateTexture:&mapped]);
+        ASSERT_EQ(mapped.width, width);
+        ASSERT_EQ(mapped.height, height);
+        ASSERT_EQ(mapped.num_textures, 1u);
+        id<MTLTexture> texture = (__bridge id<MTLTexture>)mapped.textures[0];
+        unsigned char sample[4] = {};
+        [texture getBytes:sample bytesPerRow:4
+               fromRegion:MTLRegionMake2D(width - 1, height - 1, 1, 1) mipmapLevel:0];
+        for (auto channel : sample) EXPECT_EQ(channel, 41 + cycle);
+        if (!retained) retained = texture;
+        producer.pixelBuffer = nullptr;
+        CVPixelBufferRelease(pixels);
+      }
+    }
+  }
+  // Live frame references survive replacement and destruction of their cache.
+  holder = nil;
+  unsigned char sample[4] = {};
+  [retained getBytes:sample bytesPerRow:4 fromRegion:MTLRegionMake2D(0, 0, 1, 1)
+           mipmapLevel:0];
+  for (auto channel : sample) EXPECT_EQ(channel, 41);
+  const NSUInteger end = metal.device.currentAllocatedSize;
+  EXPECT_LT(end, start + 32 * 1024 * 1024)
+      << "Retired video pools remain allocated: start=" << start << " end=" << end;
+}
