 - (BOOL)isDispatchingKeyEvent:(NSEvent*)event {
-  return _eventBeingDispatched == event;
+  if (_eventBeingDispatched == event) {
+    return YES;
+  }
+  // AppKit's cancel-key fallback can create a new Escape event with a zero
+  // timestamp while synchronously redispatching an unhandled Escape. Object
+  // identity alone then sends the clone through Flutter indefinitely. Keep
+  // that synthetic key equivalent in the native responder chain, just like
+  // the original event. Unrelated and newly delivered key events are unchanged.
+  constexpr uint16_t kEscapeKeyCode = 0x35;
+  return _eventBeingDispatched != nil && event.type == NSEventTypeKeyDown &&
+         _eventBeingDispatched.type == NSEventTypeKeyDown && event.timestamp == 0 &&
+         event.keyCode == kEscapeKeyCode && _eventBeingDispatched.keyCode == kEscapeKeyCode &&
+         event.modifierFlags == _eventBeingDispatched.modifierFlags;
 }
 
