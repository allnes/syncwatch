    {
      "type": "default",
      "name": "SyncWatch Dev",
      "program": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceRoot}\\scripts\\bootstrap_and_run.ps1"
      ],
      "currentDir": "${workspaceRoot}",
      "noDebug": true
    }
  ]
